%% Arrows organize concepts and workflow; they do not define instruction precedence.
%% The project-specific rule file below is proposed, not installed.
flowchart TB
    TITLE["CLAUDE CODE RULES<br/>Enterprise standards applied to board inspection UI development"]

    subgraph CONTEXT["1. ORGANIZE ENGINEERING GUIDANCE"]
        direction LR
        ENTERPRISE["Enterprise standards<br/>Architecture · Security · Quality"]
        PROJECT["CLAUDE.md<br/>Project purpose, boundaries and conventions"]
        RULES[".claude/rules/<br/>Small, focused, verifiable instructions"]
        GENERAL["Rules without paths<br/>General project guidance"]
        SCOPED["Rules with paths<br/>Relevant guidance when matching files are read"]
        ENTERPRISE -->|Inform| PROJECT
        PROJECT -->|Detailed guidance| RULES
        RULES --> GENERAL
        RULES --> SCOPED
    end

    subgraph WORK["2. APPLY TO A PROJECT TASK"]
        direction TB
        REQUEST["Example developer request<br/>Improve CTA spacing and test its action callback"]
        EXAMPLE["Proposed rule example — not installed<br/>.claude/rules/frontend/controlled-uispec.md<br/>Paths: apps/ui/**/* and tests/renderer_fixtures/**/*.py"]
        CLAUDE["Claude Code<br/>Inspect existing code and make the scoped change"]
        LIMITS["Preserve project boundaries<br/>No raw-model rendering or executable content<br/>No invented routes, live data or quality decisions"]
        REQUEST --> CLAUDE
        EXAMPLE -.->|Guides matching work| CLAUDE
        LIMITS -.->|Constrains the change| CLAUDE
    end

    subgraph CONTROLS["3. PRESERVE THE IMPLEMENTED RENDERING BOUNDARY"]
        direction TB
        INPUT["Fixed synthetic UISpec<br/>+ complete GroundedContext"]
        VALIDATOR["Task 3 Python validator<br/>Selected schema + grounding + deterministic policy checks"]
        VALID{"Validation passed?"}
        STOP["Stop fixture preparation<br/>Remove stale generated fixture and evidence"]
        VERIFIED["Static fixture module + verification evidence<br/>Private issuance of an ApprovedUISpec handle"]
        RENDER["Task 4 ControlledRenderer<br/>Issued-handle lookup + whole-page preflight"]
        SUPPORTED{"Registry entries and<br/>action bindings supported?"}
        REJECT["Reject the whole rendering<br/>No omission, substitution or repair"]
        COMPONENTS["Explicit nine-component registry<br/>Hero · Heading · Text · FeatureCard · FeatureGrid<br/>CTA · Alert · InfoPanel · ProgressIndicator"]
        UI["Safe React presentation<br/>Explicit DOM props · Supplied text and values<br/>Five approved action IDs · Inert demo controls"]
        INPUT --> VALIDATOR --> VALID
        VALID -->|No| STOP
        VALID -->|Yes| VERIFIED --> RENDER --> SUPPORTED
        SUPPORTED -->|No| REJECT
        SUPPORTED -->|Yes| COMPONENTS --> UI
    end

    subgraph EVIDENCE["4. VERIFY AND REVIEW"]
        direction LR
        CHECKS["Required checks<br/>Renderer tests · TypeScript · Safety lint · Build<br/>Python validator and fixture-handoff tests"]
        REPORT["Reviewable change<br/>Actual results · Changed files · Limitations<br/>Human review before further work"]
        CHECKS --> REPORT
    end

    NOTE["Rules guide the coding assistant; code and checks enforce the boundary.<br/>VALID means presentation validation, never board PASS/FAIL or approval.<br/>This fixture demonstration has no live model or validator-to-browser transport."]

    TITLE --> ENTERPRISE
    PROJECT -.-> CLAUDE
    GENERAL -.-> CLAUDE
    SCOPED -.-> EXAMPLE
    CLAUDE -.->|Maintain this existing flow| RENDER
    CLAUDE -->|Verify the change| CHECKS
    UI -->|Rendering and action assertions| CHECKS
    REPORT --> NOTE

