{
  "name": "@board-inspection/ui",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "UI Runtime. Controlled UISpec renderer and approved component registry.",
  "scripts": {
    "prepare:fixtures": "node scripts/prepare.mjs",
    "dev": "npm run prepare:fixtures && vite",
    "typecheck": "tsc --noEmit",
    "lint": "node scripts/safety-lint.mjs",
    "test": "npm run prepare:fixtures && vitest run",
    "test:watch": "vitest",
    "build": "npm run prepare:fixtures && tsc --noEmit && vite build"
  },
  "dependencies": {
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.0",
    "@types/node": "^26.6.2",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.0",
    "jsdom": "^26.1.0",
    "typescript": "^5.9.0",
    "vite": "^7.1.0",
    "vitest": "^3.2.0"
  }
}
