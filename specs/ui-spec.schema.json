{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://internal.virtusa/manufacturing-ai/schemas/ui-spec-1.0.json",
  "title": "SUPERSEDED — UI specification, version 1.0 (alternative draft)",
  "deprecated": true,
  "$comment": "SUPERSEDED. The authoritative schema is specs/schemas/ui-spec.schema.json, which is the file services/domain/validator.py loads (see SCHEMA_PATH). This copy is not loaded by any code and imposes different bounds; the differences are tabulated in specs/TASK-3-READINESS.md. It is retained for that comparison only. Do not merge the two, and do not validate against this file.",
  "description": "Structured output contract for the UI generation model. Normative prose lives in specs/model-contracts.md. This schema covers Gate 1 (structural) and the value-set portion of Gate 2 (registry). Grounding checks (Gate 3), text policy and decision-language checks (Gate 4), and the total-text-length limit are enforced in the validation pipeline and cannot be expressed here.",
  "type": "object",
  "additionalProperties": false,
  "required": ["specVersion", "page", "contextId", "blocks"],
  "properties": {
    "specVersion": { "const": "1.0" },
    "page": { "const": "landing" },
    "contextId": { "type": "string", "minLength": 1, "maxLength": 128 },
    "blocks": {
      "type": "array",
      "minItems": 1,
      "maxItems": 12,
      "items": { "$ref": "#/$defs/block" }
    }
  },
  "$defs": {
    "actionId": {
      "description": "Approved action identifier. Must also be present in the request's grounded context actions; that check is Gate 3.",
      "enum": [
        "view-inspection-queue",
        "view-defect-reports",
        "view-ingest-activity",
        "open-documentation",
        "contact-support"
      ]
    },
    "contextRefId": {
      "description": "Identifier that must exist in the grounded context. Existence is checked at Gate 3.",
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[a-z0-9][a-z0-9-]*$"
    },
    "featureCardProps": {
      "type": "object",
      "additionalProperties": false,
      "required": ["title", "body"],
      "properties": {
        "title": { "type": "string", "minLength": 1, "maxLength": 60 },
        "body": { "type": "string", "minLength": 1, "maxLength": 240 },
        "icon": { "enum": ["inspection", "defect", "report", "image", "trend"] },
        "capabilityId": { "$ref": "#/$defs/contextRefId" }
      }
    },
    "block": {
      "type": "object",
      "additionalProperties": false,
      "required": ["component", "props"],
      "properties": {
        "component": {
          "enum": [
            "Hero",
            "Heading",
            "Text",
            "FeatureCard",
            "FeatureGrid",
            "CTA",
            "Alert",
            "InfoPanel",
            "ProgressIndicator"
          ]
        },
        "props": { "type": "object" }
      },
      "oneOf": [
        {
          "properties": {
            "component": { "const": "Hero" },
            "props": {
              "type": "object",
              "additionalProperties": false,
              "required": ["title"],
              "properties": {
                "eyebrow": { "type": "string", "minLength": 1, "maxLength": 40 },
                "title": { "type": "string", "minLength": 1, "maxLength": 80 },
                "subtitle": { "type": "string", "minLength": 1, "maxLength": 200 },
                "primaryAction": { "$ref": "#/$defs/actionId" }
              }
            }
          }
        },
        {
          "properties": {
            "component": { "const": "Heading" },
            "props": {
              "type": "object",
              "additionalProperties": false,
              "required": ["level", "text"],
              "properties": {
                "level": { "enum": [2, 3] },
                "text": { "type": "string", "minLength": 1, "maxLength": 80 }
              }
            }
          }
        },
        {
          "properties": {
            "component": { "const": "Text" },
            "props": {
              "type": "object",
              "additionalProperties": false,
              "required": ["text"],
              "properties": {
                "text": { "type": "string", "minLength": 1, "maxLength": 500 },
                "tone": { "enum": ["default", "muted"] }
              }
            }
          }
        },
        {
          "properties": {
            "component": { "const": "FeatureCard" },
            "props": { "$ref": "#/$defs/featureCardProps" }
          }
        },
        {
          "properties": {
            "component": { "const": "FeatureGrid" },
            "props": {
              "type": "object",
              "additionalProperties": false,
              "required": ["columns", "items"],
              "properties": {
                "columns": { "enum": [2, 3] },
                "items": {
                  "type": "array",
                  "minItems": 2,
                  "maxItems": 6,
                  "items": { "$ref": "#/$defs/featureCardProps" }
                }
              }
            }
          }
        },
        {
          "properties": {
            "component": { "const": "CTA" },
            "props": {
              "type": "object",
              "additionalProperties": false,
              "required": ["label", "action"],
              "properties": {
                "label": { "type": "string", "minLength": 1, "maxLength": 40 },
                "action": { "$ref": "#/$defs/actionId" },
                "variant": { "enum": ["primary", "secondary"] }
              }
            }
          }
        },
        {
          "properties": {
            "component": { "const": "Alert" },
            "props": {
              "type": "object",
              "additionalProperties": false,
              "required": ["severity", "title", "body"],
              "properties": {
                "severity": { "enum": ["info", "warning", "critical"] },
                "title": { "type": "string", "minLength": 1, "maxLength": 80 },
                "body": { "type": "string", "minLength": 1, "maxLength": 300 },
                "defectCategoryId": { "$ref": "#/$defs/contextRefId" },
                "alertId": { "$ref": "#/$defs/contextRefId" }
              }
            }
          }
        },
        {
          "properties": {
            "component": { "const": "InfoPanel" },
            "props": {
              "type": "object",
              "additionalProperties": false,
              "required": ["title", "rows"],
              "properties": {
                "title": { "type": "string", "minLength": 1, "maxLength": 60 },
                "rows": {
                  "type": "array",
                  "minItems": 1,
                  "maxItems": 8,
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": ["metricId", "label", "value"],
                    "properties": {
                      "metricId": { "$ref": "#/$defs/contextRefId" },
                      "label": { "type": "string", "minLength": 1, "maxLength": 40 },
                      "value": { "type": "string", "minLength": 1, "maxLength": 40 },
                      "unit": { "type": "string", "minLength": 1, "maxLength": 12 }
                    }
                  }
                }
              }
            }
          }
        },
        {
          "properties": {
            "component": { "const": "ProgressIndicator" },
            "props": {
              "type": "object",
              "additionalProperties": false,
              "required": ["metricId", "label", "value"],
              "properties": {
                "metricId": { "$ref": "#/$defs/contextRefId" },
                "label": { "type": "string", "minLength": 1, "maxLength": 40 },
                "value": { "type": "number", "minimum": 0, "maximum": 100 },
                "caption": { "type": "string", "minLength": 1, "maxLength": 120 }
              }
            }
          }
        }
      ]
    }
  }
}
